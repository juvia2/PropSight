# Server-side secrets only. Restart the backend after entering keys.
# VWorld: national priority API / land use plan attributes.
VWORLD_API_KEY=
# Must match the service URL registered with VWorld.
VWORLD_DOMAIN=http://localhost:5173
# data.go.kr keys: the same key may be used if all three services are approved.
# Both encoded and decoded service keys are accepted.
BUILDING_PERMIT_API_KEY=
HOUSING_PERMIT_API_KEY=
BUILDING_REGISTER_API_KEY=

# Production only: configure these in your hosting dashboard.
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE
# ALLOWED_ORIGINS=https://your-deployment-domain
# COOKIE_SECURE=1
# SERVE_FRONTEND=1
